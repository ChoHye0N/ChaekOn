{
  "manifest_version": 3,
  "name": "ChaekOn",
  "version": "0.1.0",
  "description": "열람 권한이 있는 이미지형 웹 전자책을 PDF 한 개로 저장합니다. 모든 처리는 브라우저 안에서 합니다.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "ChaekOn: 이 책을 PDF로 저장",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "ChaekOn 패널 열기"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/core/*.js",
        "src/adapters/*.js",
        "src/ui/*.js"
      ],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
